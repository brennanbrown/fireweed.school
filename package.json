{
  "name": "fireweed-school",
  "version": "1.0.0",
  "description": "Fireweed Writing Club - An online writing class built on renewal, persistence, and the radical liberation of putting words on paper.",
  "scripts": {
    "dev": "hugo server -D",
    "build": "npm run tailwind:build && hugo --gc --minify",
    "tailwind:watch": "npx tailwindcss -i ./assets/css/main.css -o ./static/css/styles.css --watch",
    "tailwind:build": "NODE_ENV=production npx tailwindcss -i ./assets/css/main.css -o ./static/css/styles.css --minify"
  },
  "keywords": [
    "writing",
    "education",
    "hugo",
    "tailwindcss"
  ],
  "author": "Brennan Kenneth Brown",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
